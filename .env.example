# sportocal-data API keys — example file
# Copy this to .env (gitignored) and fill in real values.
# Never commit your real keys.
#
# How to get each key:
#   API_SPORTS_KEY    → https://dashboard.api-sports.io (reset yours before use)
#   FOOTBALL_DATA_KEY → https://www.football-data.org/client/register
#   BALLDONTLIE_KEY   → https://www.balldontlie.io (sign up, free tier key)

API_SPORTS_KEY=your_api_sports_key_here
FOOTBALL_DATA_KEY=your_football_data_key_here
BALLDONTLIE_KEY=your_balldontlie_key_here
